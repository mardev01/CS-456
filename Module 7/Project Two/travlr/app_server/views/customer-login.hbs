<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{title}} - Travlr Getaways</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/customer.css"></head><body><div id="background"><div id="page">{{> header }}<main id="contents"><div class="box"><div><div class="body customer-body"><h1>{{title}}</h1>{{#if error}}<p class="notice error" role="alert">{{error}}</p>{{/if}}
<form method="post" action="/account/login" class="account-form">
<input type="hidden" name="_csrf" value="{{csrfToken}}"><input type="hidden" name="returnTo" value="{{returnTo}}">
<label for="email">Email</label><input id="email" name="email" type="email" value="{{email}}" autocomplete="username" required maxlength="254">
<label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128">
<button type="submit">Sign In</button></form>
<p>New to Travlr? <a href="/account/register?returnTo={{returnTo}}">Create a customer account</a>.</p>
<p>Managing trip packages? <a href="/admin">Open administrator sign in</a>.</p>
</div></div></div></main></div>{{> footer }}</div></body></html>
